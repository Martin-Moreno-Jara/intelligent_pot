# =============================================================================
# Configuración del dashboard de la Raspberry Pi.
# Copiá este archivo a ".env" (cp .env.example .env) y completá tus datos.
# Los topics y las credenciales deben COINCIDIR con los del ESP32 (config.h).
# =============================================================================

# --- HiveMQ Cloud (los mismos datos que pusiste en el ESP32) ---
MQTT_HOST=xxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=matera
MQTT_PASS=CAMBIA_ESTA_CLAVE
# El client-id debe ser DISTINTO al del ESP32 (no pueden repetirse conectados).
MQTT_CLIENT_ID=matera-raspi

# --- Topics (idénticos a los del ESP32) ---
TOPIC_SENSORS=matera/sensors
TOPIC_CMD_PUMP=matera/cmd/pump
TOPIC_CMD_PLAY=matera/cmd/play

# --- Servidor web local del dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
